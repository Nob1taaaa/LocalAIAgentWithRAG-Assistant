# Vite dev server (default 5175). Proxies /api to VITE_API_PROXY_TARGET.
VITE_DEV_PORT=5175
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# The GitHub repository whose PRs and Actions runs Assist Ledger reads.
GITHUB_REPOSITORY=Nob1taaaa/LocalAIAgentWithRAG-Assistant

# Optional for public repositories; required for private repositories or higher API limits.
GITHUB_TOKEN=

# Set this in GitHub webhook settings after deploying a publicly reachable server.
GITHUB_WEBHOOK_SECRET=

# Shared secret required by POST /api/telemetry/tokens.
ASSIST_LEDGER_INGEST_KEY=

# Optional path for the local SQLite database (defaults to ./data/assist-ledger.sqlite).
DATABASE_PATH=
