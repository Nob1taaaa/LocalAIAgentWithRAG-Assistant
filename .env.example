# Ollama API base URL. Direct Ollama avoids requiring the optional telemetry proxy.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=10m
OLLAMA_EMBEDDING_KEEP_ALIVE=600
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=256

# Optional: mirror model-usage metadata to the local Assist Ledger dashboard API.
ASSIST_LEDGER_DASHBOARD_URL=http://127.0.0.1:3000

# Copy to .env and fill these after deploying the record-model-usage function.
# This ingestion key is separate from every Supabase/GitHub key.
ASSIST_LEDGER_FUNCTION_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/record-model-usage
ASSIST_LEDGER_INGEST_KEY=replace-with-the-function-ingest-key
SUPABASE_PUBLISHABLE_KEY=your-project-publishable-key
ASSIST_LEDGER_REPOSITORY=Nob1taaaa/LocalAIAgentWithRAG-Assistant
# Optional: set only while working on a specific PR, for explicit attribution.
# ASSIST_LEDGER_PULL_REQUEST_NUMBER=123
